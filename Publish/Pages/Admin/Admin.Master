<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="_24_1639DelMundoPersonalPortfolio.AdminMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> — Admin Console</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Geist+Pixel&display=swap" rel="stylesheet">
    
    <link href="<%= ResolveUrl("~/Content/Admin.css") %>" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/dark.css">

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="<%= ResolveUrl("~/Scripts/Admin.js") %>"></script>

    <asp:ContentPlaceHolder ID="adminHead" runat="server">
    </asp:ContentPlaceHolder>

</head>
<body>
    <!-- Reusable Toast Container (top of body for immediate availability) -->
    <div class="admin-toast-container" id="adminToastContainer" aria-live="polite"></div>

    <form id="form1" runat="server" enctype="multipart/form-data" novalidate="novalidate">
        <input type="hidden" id="hidActivePanel" name="hidActivePanel" value="" />

        <div class="admin-shell" id="adminShell">
            <script>
                (function() {
                    try {
                        var saved = localStorage.getItem("admin_sidebar_collapsed");
                        var isMobile = window.innerWidth <= 800;
                        if (saved === "true" || (saved === null && isMobile)) {
                            document.getElementById("adminShell").classList.add("sidebar-collapsed");
                        }
                    } catch(e) {}
                })();
            </script>
            <!-- ============ COLLAPSIBLE SIDEBAR ============ -->
            <nav class="admin-nav" id="adminNav">
                <div class="admin-nav-header">
                    <div class="admin-brand">
                        <span class="admin-brand-title"><%= _24_1639DelMundoPersonalPortfolio.Helpers.AuthHelper.IsAdmin() ? "ADMIN CONSOLE" : "WEBSITE BUILDER" %></span>
                    </div>
                    <button type="button" id="btnToggleSidebar" class="sidebar-toggle-btn" title="Toggle Sidebar" aria-label="Toggle Sidebar">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </button>
                </div>

                <div class="admin-menu">
<% if (_24_1639DelMundoPersonalPortfolio.Helpers.AuthHelper.IsAdmin()) { %>
                    <!-- Admin Views: Statistics, Telemetry, and User Management -->
                    <a href="javascript:void(0)" class="nav-item active" data-panel="dashboard" data-tooltip="Dashboard">
                        <span class="nav-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="7" height="7"></rect>
                                <rect x="14" y="3" width="7" height="7"></rect>
                                <rect x="14" y="14" width="7" height="7"></rect>
                                <rect x="3" y="14" width="7" height="7"></rect>
                            </svg>
                        </span>
                        <span class="nav-label">Dashboard</span>
                    </a>

                    <a href="javascript:void(0)" class="nav-item" data-panel="users" data-tooltip="Users">
                        <span class="nav-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        </span>
                        <span class="nav-label">Users</span>
                    </a>

                    <div class="nav-divider"></div>

                    <!-- Admin Profile / Security Tab -->
                    <a href="javascript:void(0)" class="nav-item" data-panel="admin-profile" data-tooltip="Admin Profile">
                        <span class="nav-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                        </span>
                        <span class="nav-label">Admin Profile</span>
                    </a>
<% } else { %>
                   

                    <!-- User Personal Website Management Tabs -->
                    <a href="javascript:void(0)" class="nav-item active" data-panel="profile" data-tooltip="Profile">
                        <span class="nav-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </span>
                        <span class="nav-label">Profile</span>
                    </a>

                    <a href="javascript:void(0)" class="nav-item" data-panel="techstack" data-tooltip="Tech Stack">
                        <span class="nav-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                <polyline points="2 17 12 22 22 17"></polyline>
                                <polyline points="2 12 12 17 22 12"></polyline>
                            </svg>
                        </span>
                        <span class="nav-label">Tech Stack</span>
                    </a>

                    <a href="javascript:void(0)" class="nav-item" data-panel="skills" data-tooltip="Skills">
                        <span class="nav-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="20" x2="18" y2="10"></line>
                                <line x1="12" y1="20" x2="12" y2="4"></line>
                                <line x1="6" y1="20" x2="6" y2="14"></line>
                            </svg>
                        </span>
                        <span class="nav-label">Skills</span>
                    </a>

                    <a href="javascript:void(0)" class="nav-item" data-panel="experience" data-tooltip="Experience">
                        <span class="nav-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                            </svg>
                        </span>
                        <span class="nav-label">Experience</span>
                    </a>

                    <a href="javascript:void(0)" class="nav-item" data-panel="projects" data-tooltip="Projects">
                        <span class="nav-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                            </svg>
                        </span>
                        <span class="nav-label">Projects</span>
                    </a>

                    <a href="javascript:void(0)" class="nav-item" data-panel="education" data-tooltip="Education">
                        <span class="nav-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                            </svg>
                        </span>
                        <span class="nav-label">Education</span>
                    </a>

                    <a href="javascript:void(0)" class="nav-item" data-panel="awards" data-tooltip="Awards">
                        <span class="nav-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="8" r="7"></circle>
                                <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                            </svg>
                        </span>
                        <span class="nav-label">Awards</span>
                    </a>

                    <a href="javascript:void(0)" class="nav-item" data-panel="hobbies" data-tooltip="Hobbies">
                        <span class="nav-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                            </svg>
                        </span>
                        <span class="nav-label">Hobbies</span>
                    </a>

                    <a href="javascript:void(0)" class="nav-item" data-panel="contacts" data-tooltip="Contacts &amp; Socials">
                        <span class="nav-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                        </span>
                        <span class="nav-label">Contacts</span>
                    </a>
<% } %>

<% if (!_24_1639DelMundoPersonalPortfolio.Helpers.AuthHelper.IsAdmin()) { %>
                    <div class="nav-divider"></div>
                     <!-- User Account / Credentials -->
                    <a href="javascript:void(0)" class="nav-item" data-panel="account" data-tooltip="Account">
                        <span class="nav-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="3"></circle>
                                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                            </svg>
                        </span>
                        <span class="nav-label">Account</span>
                    </a>

                    <a href="<%= ResolveUrl("~/Default.aspx") %>" class="nav-item" data-tooltip="View My Website" target="_blank">
                        <span class="nav-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                <polyline points="9 22 9 12 15 12 15 22"></polyline>
                            </svg>
                        </span>
                        <span class="nav-label">View My Website</span>
                    </a>
<% } %>
                </div>

                <!-- Sidebar Footer with Logout Button -->
                <div class="admin-nav-foot">
                    <button type="button" id="btnLogout" class="admin-logout-btn" data-redirect="<%= ResolveUrl("~/Auth/SignIn.aspx?logout=true") %>" title="Log out">
                        <svg class="logout-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        <span class="logout-text">Log out</span>
                    </button>
                </div>
            </nav>
            <div class="admin-sidebar-backdrop" id="adminSidebarBackdrop" aria-hidden="true"></div>

            <!-- ============ MAIN CONTENT AREA ============ -->
            <main class="admin-main">
                <!-- Top bar -->
                <div class="admin-topbar">
                    <div class="admin-topbar-left">
                        <div class="kicker"><%= _24_1639DelMundoPersonalPortfolio.Helpers.AuthHelper.IsAdmin() ? "SYSTEM MANAGEMENT" : "WEBSITE BUILDER" %></div>
                        <h2 id="currentPanelTitle" style="font-family: var(--f-display); font-weight: 400; font-size: var(--t-lg); margin-top: 4px;"><%= _24_1639DelMundoPersonalPortfolio.Helpers.AuthHelper.IsAdmin() ? "Dashboard" : "Profile" %></h2>
                    </div>
                    <div style="display: flex; align-items: center; gap: 12px;">
<% if (!_24_1639DelMundoPersonalPortfolio.Helpers.AuthHelper.IsAdmin()) { %>
                        <a href="<%= ResolveUrl("~/Default.aspx") %>" class="btn btn-secondary" target="_blank" style="display: inline-flex; align-items: center; gap: 6px; font-size: var(--t-xs); padding: 6px 14px; text-decoration: none;">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                <polyline points="15 3 21 3 21 9"></polyline>
                                <line x1="10" y1="14" x2="21" y2="3"></line>
                            </svg>
                            <span>View My Website</span>
                        </a>
<% } %>
                       
                    </div>
                </div>

                <!-- Child Page Content Placeholder -->
                <asp:ContentPlaceHolder ID="AdminMainContent" runat="server">
                </asp:ContentPlaceHolder>
            </main>
        </div>
    </form>

    <!-- Reusable Modal Dialog -->
    <div class="admin-modal-overlay" id="adminModalOverlay" aria-hidden="true">
        <div class="admin-modal-dialog" id="adminModalDialog" role="dialog" aria-modal="true">
            <div class="admin-modal-header">
                <div class="admin-modal-title" id="adminModalTitle">
                    <span class="admin-modal-title-icon" id="adminModalIcon"></span>
                    <span id="adminModalTitleText">Confirmation</span>
                </div>
                <button type="button" class="admin-modal-close-btn" id="adminModalCloseBtn" title="Close modal" aria-label="Close modal">&times;</button>
            </div>
            <div class="admin-modal-body" id="adminModalBody">
                <p id="adminModalMessage">Are you sure you want to proceed?</p>
            </div>
            <div class="admin-modal-footer" id="adminModalFooter">
                <button type="button" class="btn btn-secondary" id="adminModalCancelBtn">Cancel</button>
                <button type="button" class="btn btn-primary" id="adminModalConfirmBtn">Confirm</button>
            </div>
        </div>
    </div>

    <div class="custom-cursor" id="customCursor" aria-hidden="true">
        <div class="custom-cursor-circle"></div>
    </div>

    <asp:ContentPlaceHolder ID="adminScripts" runat="server">
    </asp:ContentPlaceHolder>

    <script>
        // Prevent form resubmission when user refreshes the page (F5)
        if (window.history && window.history.replaceState) {
            window.history.replaceState(null, document.title, window.location.href);
        }
    </script>
</body>
</html>
