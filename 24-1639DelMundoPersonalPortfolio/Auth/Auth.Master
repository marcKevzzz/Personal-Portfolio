<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Auth.Master.cs" Inherits="_24_1639DelMundoPersonalPortfolio.AuthMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> — KEVS Auth</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Geist+Pixel&display=swap" rel="stylesheet">
    
    <link href="<%= ResolveUrl("~/Content/Site.css") %>" rel="stylesheet" />
    
    <asp:ContentPlaceHolder ID="authHead" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="authForm" runat="server">
        <asp:ContentPlaceHolder ID="authContent" runat="server">
        </asp:ContentPlaceHolder>
    </form>

    <div class="admin-toast-container" id="adminToastContainer" aria-live="polite"></div>

    <div class="custom-cursor" id="customCursor" aria-hidden="true">
        <div class="custom-cursor-circle"></div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script src="<%= ResolveUrl("~/Scripts/Scripts.js") %>"></script>
    <asp:ContentPlaceHolder ID="authScripts" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>
